# ==============================================================================
# Node & Dependencies
# ==============================================================================
# Never commit your heavy dependencies folder
node_modules/
jspm_packages/


#txt files
*.txt
# Build logs and profiling configs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
.eslintcache

# ==============================================================================
# Electron Binaries & Build Artifacts
# ==============================================================================
# Ignore local Electron builds and packaged distributables (e.g., from electron-builder or forge)
dist/
out/
build/

# Core dumps or crash dumps generated during desktop debugging
*.dmp
*.clog

# ==============================================================================
# Databases & Local Storage
# ==============================================================================
# Since you're using better-sqlite3, ignore local development database files 
# so you don't commit test data or lock files to git.
*.db
*.sqlite
*.sqlite3
*.db-journal
*.db-wal
*.db-shm

# ==============================================================================
# Environment Variables & Secrets
# ==============================================================================
# Keep API keys, session secrets, or configuration values safe locally
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# ==============================================================================
# Operating System Junk
# ==============================================================================
# macOS
.DS_Store
.AppleDouble
.LSOverride

# Windows
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
*.lnk

# ==============================================================================
# IDEs & Code Editors
# ==============================================================================
# VS Code
.vscode/
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json

# WebStorm / JetBrains
.idea/

